default(parisize,"1G"); K=2^20; KM=2^16;

sq(r,p)={ if(p%4==3, lift(Mod(r,p)^((p+1)/4)), lift(sqrt(Mod(r,p)))) };
scan(name,i,p,b,gx)={
  my(E=ellinit([-3,b],p), xs=[], P, Q, M=Map(), hits=[], y);
  for(x=0,60, if(#xs<8 && issquare(Mod(x^3-3*x+b,p)), xs=concat(xs,x)));
  write("pts.out", name," ",i," small-x points at x=",xs,"  (root convention: ",if(p%4==3,"(p+1)/4 power","Tonelli-Shanks, both roots listed"),")");
  for(j=1,#xs, y=sq(xs[j]^3-3*xs[j]+b,p); write("pts.out","   x=",xs[j],"  y=",y,"  other root=",p-y));
  P=[Mod(xs[1],p), Mod(sq(xs[1]^3-3*xs[1]+b,p),p)];
  for(j=1,#xs, mapput(M,xs[j],Str("x=",xs[j])));
  if(gx, mapput(M,gx,"Gx"); write("pts.out","   published Gx = ",gx,"  on curve: ",issquare(Mod(gx^3-3*gx+b,p))));
  Q=P;
  for(k=1,K, if(k>1,Q=elladd(E,Q,P)); if(mapisdefined(M,lift(Q[1])), hits=concat(hits,[Str(k,"*P(x=",xs[1],") has ",mapget(M,lift(Q[1])))])));
  if(gx, Q=[Mod(gx,p), Mod(sq(gx^3-3*gx+b,p),p)]; P=Q;
    for(k=2,K, Q=elladd(E,Q,P); if(mapisdefined(M,lift(Q[1])), hits=concat(hits,[Str(k,"*G has ",mapget(M,lift(Q[1])))]))));
  write("pts.out","   small-scalar relations (k<=2^20, up to sign): ", if(#hits, hits, "none beyond trivial"));
};
mult(name,p,b,gx,n)={
  my(E=ellinit([-3,b],p), Gp=[Mod(gx,p), Mod(sq(gx^3-3*gx+b,p),p)], Q, R, thr=#binary(p)-32, found=[], best=#binary(p), bestk="");
  write("mult.out", name,": G on curve ",issquare(Mod(gx^3-3*gx+b,p)),", n*G=O: ",ellmul(E,Gp,n)==[0]);
  Q=Gp;
  for(k=2,KM, Q=elladd(E,Q,Gp); my(x=lift(Q[1]),y=lift(Q[2]),bx=#binary(x),by=#binary(y),bym=#binary(min(y,p-y)));
     if(bx<best, best=bx; bestk=Str(k,"*G x"));
     if(bx<=thr || bym<=thr, found=concat(found,[Str(k,"*G: x bits ",bx,", y bits ",bym)])));
  for(k=2,KM, R=ellmul(E,Gp,lift(Mod(k,n)^-1)); my(x=lift(R[1]),y=lift(R[2]),bx=#binary(x),bym=#binary(min(y,p-y)));
     if(bx<best, best=bx; bestk=Str("G/",k," x"));
     if(bx<=thr || bym<=thr, found=concat(found,[Str("G/",k,": x bits ",bx,", y bits ",bym)])));
  write("mult.out","   half point G/2: x = ",lift(ellmul(E,Gp,lift(Mod(2,n)^-1))[1]));
  write("mult.out","   shortest x among k*G, G/k for 2<=k<=2^16: ",best," bits at ",bestk,"  (p has ",#binary(p)," bits; expected min over 2^17 random ~ ",#binary(p)-17,")");
  write("mult.out","   coordinates at least 32 bits short: ", if(#found, found, "none"));
};
