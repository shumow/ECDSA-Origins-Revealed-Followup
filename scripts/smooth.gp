default(parisize,"512M");
rep(lab,x)={my(F=factor(x,10^7),k=#F[,1],big=F[k,1],s=""); s=Str(lab," = ",vecextract(F[,1],Str("1..",k-1)),"^",vecextract(F[,2],Str("1..",k-1))," * C, C is ",#binary(big),"-bit, ",if(ispseudoprime(big),"PRIME","composite")); write("smooth.out",s)};
